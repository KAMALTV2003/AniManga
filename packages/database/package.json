{
  "name": "@nexus-ai/database",
  "version": "0.1.0-dev.1",
  "description": "Versioned local database and repositories for NEXUS AI",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@nexus-ai/core": "0.1.0-dev.1",
    "better-sqlite3": "13.0.3"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
