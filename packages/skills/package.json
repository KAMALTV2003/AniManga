{
  "name": "@nexus-ai/skills",
  "version": "0.1.0-dev.1",
  "description": "Secure canonical Skill analysis, normalization, versioning, and registry for NEXUS AI",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/nexus-skill-v1.schema.json": "./schema/nexus-skill-v1.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf dist",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@nexus-ai/core": "0.1.0-dev.1",
    "@nexus-ai/database": "0.1.0-dev.1",
    "semver": "7.8.5",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  }
}
