{
  "name": "nexus-phase4-selection-regression",
  "version": "2",
  "license": "CC0-1.0",
  "description": "Synthetic deterministic software-capability selection regression suite with lexical and structured-metadata cases. It is not an external or model-quality benchmark.",
  "capabilities": [
    {
      "name": "release-notes",
      "description": "Draft release notes and changelogs from verified commits.",
      "tags": ["release"],
      "behaviors": ["release-notes", "changelog"],
      "contextBytes": 120
    },
    {
      "name": "security-review",
      "description": "Find vulnerabilities, unsafe flows, and policy violations in source changes.",
      "tags": ["security"],
      "behaviors": ["security-review", "threat-analysis"],
      "contextBytes": 180
    },
    {
      "name": "incident-response",
      "description": "Triage incidents and prepare bounded service recovery actions.",
      "tags": ["incident"],
      "behaviors": ["incident-triage", "recovery-plan"],
      "contextBytes": 170
    },
    {
      "name": "api-documentation",
      "description": "Document typed HTTP request and response contracts.",
      "tags": ["api"],
      "behaviors": ["api-documentation", "schema-documentation"],
      "contextBytes": 140
    },
    {
      "name": "dependency-audit",
      "description": "Audit dependency manifests, licenses, provenance, and advisories.",
      "tags": ["dependencies"],
      "behaviors": ["dependency-audit", "license-review"],
      "contextBytes": 190
    },
    {
      "name": "test-planning",
      "description": "Plan deterministic boundary, failure, and regression tests.",
      "tags": ["testing"],
      "behaviors": ["test-planning", "regression-design"],
      "contextBytes": 130
    },
    {
      "name": "schema-migration",
      "description": "Plan schema migrations with compatibility and data integrity checks.",
      "tags": ["migration"],
      "behaviors": ["schema-migration"],
      "contextBytes": 210,
      "dependsOn": ["database-backup", "rollback-plan"]
    },
    {
      "name": "database-backup",
      "description": "Create and verify consistent database backup snapshots.",
      "tags": ["backup"],
      "behaviors": ["database-backup"],
      "contextBytes": 100
    },
    {
      "name": "performance-profile",
      "description": "Profile latency, throughput, CPU, and memory usage.",
      "tags": ["performance"],
      "behaviors": ["performance-profile"],
      "contextBytes": 160
    },
    {
      "name": "cost-analysis",
      "description": "Analyze model token cost and execution budget usage.",
      "tags": ["cost"],
      "behaviors": ["cost-analysis"],
      "contextBytes": 110
    },
    {
      "name": "accessibility-review",
      "description": "Review user interfaces for accessibility requirements.",
      "tags": ["accessibility"],
      "behaviors": ["accessibility-review"],
      "contextBytes": 150
    },
    {
      "name": "localization",
      "description": "Prepare localization resources and locale coverage checks.",
      "tags": ["localization"],
      "behaviors": ["localization"],
      "contextBytes": 125
    },
    {
      "name": "changelog-validation",
      "description": "Validate changelog structure, links, versions, and release dates.",
      "tags": ["changelog-validation"],
      "behaviors": ["changelog-validation"],
      "contextBytes": 90
    },
    {
      "name": "policy-review",
      "description": "Review declarative policy rules for conflicts and unsafe permissions.",
      "tags": ["policy"],
      "behaviors": ["policy-review"],
      "contextBytes": 175
    },
    {
      "name": "provenance-audit",
      "description": "Verify source hashes, revisions, attribution, and provenance links.",
      "tags": ["provenance"],
      "behaviors": ["provenance-audit"],
      "contextBytes": 135
    },
    {
      "name": "retrieval-evaluation",
      "description": "Measure retrieval recall, ranking quality, regressions, and latency.",
      "tags": ["retrieval-evaluation"],
      "behaviors": ["retrieval-evaluation"],
      "contextBytes": 145
    },
    {
      "name": "rollback-plan",
      "description": "Design deterministic rollback checkpoints and restoration verification.",
      "tags": ["rollback"],
      "behaviors": ["rollback-plan"],
      "contextBytes": 105
    },
    {
      "name": "context-optimizer",
      "description": "Reduce prompt context while preserving required evidence and constraints.",
      "tags": ["context"],
      "behaviors": ["context-optimization"],
      "contextBytes": 115
    }
  ],
  "cases": [
    {
