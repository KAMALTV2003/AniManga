{
  "name": "nexus-ai",
  "version": "0.1.0-dev.1",
  "description": "A secure, measurable capability operating system for AI agents",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && find apps packages -type d -name dist -prune -exec rm -rf {} +",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "benchmark:phase1": "npm run build && node scripts/benchmark-phase1.mjs",
    "benchmark:phase2": "npm run build && node scripts/benchmark-phase2.mjs",
    "benchmark:phase3": "npm run build && node scripts/benchmark-phase3.mjs",
    "benchmark:phase4": "npm run build && node scripts/benchmark-phase4.mjs",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run check:placeholders && npm run typecheck && npm run test:coverage && npm audit --audit-level=high",
    "nexus": "node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.4",
    "@types/semver": "7.8.0",
    "@types/spdx-expression-parse": "4.0.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yazl": "3.3.1"
  }
}
